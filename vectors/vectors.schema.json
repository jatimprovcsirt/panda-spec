{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PANDATestVectors",
  "description": "Structure of the shared vector set. Note that no tool in this repository validates against this file yet — see README.md. It is here so an editor or an external CI can check a vector file, and it is written in lowercase type names because JSON Schema requires them: an earlier revision used OBJECT and STRING, which no validator accepts.",
  "type": "object",
  "properties": {
    "positive": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "key": { "type": "string" },
          "kid": { "type": "string" },
          "nonce": { "type": "string" },
          "plaintext": { "type": "string" },
          "envelope": {
            "type": "object",
            "properties": {
              "v": { "type": "integer" },
              "alg": { "type": "string" },
              "kid": { "type": "string" },
              "nonce": { "type": "string" },
              "ciphertext": { "type": "string" }
            },
            "required": ["v", "alg", "kid", "nonce", "ciphertext"]
          }
        },
        "required": ["description", "key", "kid", "nonce", "plaintext", "envelope"]
      }
    },
    "negative": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "key": { "type": "string" },
          "kid": { "type": "string" },
          "envelope": {
            "type": "object",
            "properties": {
              "v": { "type": "integer" },
              "alg": { "type": "string" },
              "kid": { "type": "string" },
              "nonce": { "type": "string" },
              "ciphertext": { "type": "string" }
            },
            "required": ["v", "alg", "kid", "nonce", "ciphertext"]
          },
          "expected_error": { "type": "string" }
        },
        "required": ["description", "key", "kid", "envelope", "expected_error"]
      }
    },
    "blindIndex": {
      "type": "object",
      "description": "Blind index vectors. The key here is a blind index key and is deliberately not the one the envelope vectors use.",
      "properties": {
        "description": { "type": "string" },
        "key": {
          "type": "string",
          "description": "Base64 of the 32-byte index key."
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "value": {
                "type": "string",
                "description": "The value to index, before normalisation."
              },
              "normalization": {
                "type": "string",
                "enum": [
                  "lowercase",
                  "email",
                  "nik",
                  "digits",
                  "phone",
                  "trim",
                  "none",
                  "raw"
                ]
              },
              "normalized": {
                "type": "string",
                "description": "What was actually hashed. Carried so a disagreement can be diagnosed as a normalisation difference rather than only as a wrong index — which is the disagreement four implementations have actually had."
              },
              "index": {
                "type": "string",
                "description": "Base64 of the 32-byte HMAC-SHA256, 44 characters ending in '='."
              },
              "note": { "type": "string" }
            },
            "required": ["description", "value", "normalization", "normalized", "index"]
          }
        }
      },
      "required": ["key", "vectors"]
    },
    "tokenFormat": {
      "type": "object",
      "description": "Access token format vectors. No key: a token format is a question about a string, not a cryptographic operation.",
      "properties": {
        "description": { "type": "string" },
        "pattern": {
          "type": "string",
          "description": "The accepted pattern, restated for a reader. Implementations are checked against this vector set, not by compiling this string."
        },
        "vectors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "token": { "type": "string" },
              "valid": {
                "type": "boolean",
                "description": "Whether the token is well-formed. Note that no token here is validated against the portal: that is a live service and is not something an offline vector can assert."
              },
              "note": { "type": "string" }
            },
            "required": ["description", "token", "valid"]
          }
        }
      },
      "required": ["pattern", "vectors"]
    }
  },
  "required": ["positive", "negative", "blindIndex", "tokenFormat"]
}
